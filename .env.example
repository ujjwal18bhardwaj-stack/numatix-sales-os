# Numatix Sales OS — environment variables
# Copy this file to .env and fill in your keys.

# Claude API (required for all agents)
ANTHROPIC_API_KEY=sk-ant-...

# ContactOut API (used by Agent 02 — Prospect Enrichment)
CONTACTOUT_API_KEY=

# Instantly.ai API (used by Agent 05 — Email Outreach)
INSTANTLY_API_KEY=
